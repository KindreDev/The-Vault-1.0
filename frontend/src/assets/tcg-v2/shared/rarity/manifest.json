    "creator": {"anchorRole": "spine", "treatment": "editorial-champagne-plaque"},
    "collab": {"anchorRole": "upper-left", "treatment": "glowing-gold-serif"},
    "gallery": {"anchorRole": "lower-right", "treatment": "double-outline-gold-serif"},
    "bond-card": {"anchorRole": "upper-center", "treatment": "icy-luminous-capsule"},
    "hall-of-fame": {"anchorRole": "lower-center", "treatment": "regal-gold-serif"}
  },
  "foilStrength": {
    "C": 0.0,
    "R": 0.18,
